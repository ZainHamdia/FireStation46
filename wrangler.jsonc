{
  "name": "firestation46",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Keep plain-text variables set in the Cloudflare dashboard (secrets are always kept)
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; every other request is served straight from static files
    "run_worker_first": ["/api/*"]
  }
}
